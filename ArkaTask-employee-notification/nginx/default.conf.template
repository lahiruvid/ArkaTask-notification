# Public entry point for the ArkaTasks API on the Oracle VM.
# The nginx image renders this template at start (envsubst, CORS_* variables only).
# Upstreams are resolved per request through Docker DNS, so a recreated backend
# container is picked up without restarting Nginx.

resolver 127.0.0.11 valid=10s ipv6=off;

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=60r/m;
limit_req_status 429;

server_tokens off;

server {
  listen 80 default_server;
  listen 443 ssl default_server;
  http2 on;
  server_name _;

  # Self-signed until a real certificate is placed in TLS_CERT_DIR (see terraform-oci/README.md).
  ssl_certificate /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:1m;

  client_max_body_size 16k;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_connect_timeout 5s;
  proxy_read_timeout 30s;

  # The web UI on Cloudflare calls this API cross-origin with a bearer token.
  add_header Access-Control-Allow-Origin "${CORS_ALLOW_ORIGIN}" always;
  add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
  add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
  add_header Access-Control-Max-Age "600" always;
  add_header Vary "Origin" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000" always;

  if ($request_method = OPTIONS) {
    return 204;
  }

  location = /nginx-health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /actuator/health {
    set $upstream login-service:8081;
    proxy_pass http://$upstream;
  }

  location = /api/login {
    limit_req zone=login burst=5 nodelay;
    set $upstream login-service:8081;
    proxy_pass http://$upstream;
  }

  location = /api/cleans {
    limit_req zone=api burst=20 nodelay;
    set $upstream clean-event-service:8082;
    proxy_pass http://$upstream;
  }

  # Everything else, including the internal /api/employees and /api/notifications, stays private.
  location / {
    default_type application/json;
    return 404 '{"error":"Not found."}';
  }
}
