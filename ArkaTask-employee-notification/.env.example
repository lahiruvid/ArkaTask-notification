# Copy to .env next to docker-compose.yml. The deploy scripts also write it.
# Public Supabase project URL. Java derives the JWKS URL and the token issuer from it.
SUPABASE_URL=https://<project-ref>.supabase.co
# Postgres password for the db container and the Java services. Single line.
DB_PASSWORD=change-me
# Image prefix. "local" matches tags from deploy/build-arm.sh --load.
REGISTRY=local
# Never put a service_role or secret key in this file.
# An optional anon key is written to seed/supabase-keys.json instead.
