# Copy to .env next to docker-compose.yml on EC2 (deploy/compose-up.sh also writes it).
# Public Supabase project URL. Java derives the JWKS URL and the token issuer from it.
# Never put a service_role or secret key here.
SUPABASE_URL=https://<project-ref>.supabase.co
# Optional overrides:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_ALGS=RS256,ES256
