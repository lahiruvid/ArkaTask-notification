# Copy to .env next to docker-compose.yml for a local run. On the VM, the deploy writes it.
# Public values only. Never put a Supabase service_role key or the Docker Hub token here.

# Docker Hub user that owns the arkatasks-employee-notification images (docker-compose.registry.yml).
DOCKERHUB_USERNAME=

# Optional. https://<project-ref>.supabase.co pins the backend to one project.
SUPABASE_URL=
# Optional. The public anon or sb_publishable_ key. Login saves it too.
SUPABASE_ANON_KEY=

# Directory with tls.crt and tls.key for Nginx. Local default: ./certs
TLS_CERT_DIR=

# Allowed browser origin for the API, for example https://<app>.pages.dev. Default: *
CORS_ALLOW_ORIGIN=
