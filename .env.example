# Copy to .env.local for `npm run dev` / `npm run build`. Never commit it.

# Optional: phone + laptop sync. Public values only (project URL and anon key).
# The Sync page can store them instead. Never put a service_role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME=DClean

# Employee login and clean taps: the Oracle backend behind Nginx, without a trailing slash.
# Use https with a real certificate (a page served over https cannot call http, and browsers
# reject the VM's self-signed certificate). Example: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=

# Daily email backup uses free FormSubmit, no API key and no paid plan required.
